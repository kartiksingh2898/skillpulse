DB_USER=your_tidb_username_from_connect_dialog
DB_PASSWORD=your_tidb_password
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=skillpulse

# SSL — required for TiDB Cloud. Set to false for local MySQL only.
DB_SSL=true

# Path to TiDB CA certificate (relative to project root).
# Download from: TiDB Cloud cluster → Connect dialog → CA cert link.
# Commit the file to certs/tidb-ca.pem (it is a public certificate, not a secret).
# Update this file if TiDB changes the recommended CA certificate.
DB_SSL_CA=certs/tidb-ca.pem

# Auto-create the database on startup (local MySQL dev only).
# Set to false for TiDB Cloud — the schema must already exist.
DB_AUTO_CREATE=false

ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
